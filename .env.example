# Relia local / production environment
# Copy to .env and fill in only what you have. The app runs without cloud keys.

# --- App ---
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:43180
CORS_ORIGINS=http://127.0.0.1:43180,http://localhost:43180
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEMO=true
# Seed is skipped automatically when APP_ENV=production.

# SQLite by default. For Postgres/Supabase:
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Next.js server-side proxy to FastAPI
API_INTERNAL_URL=http://127.0.0.1:43181

# --- Supabase (optional; never expose the service role to the browser) ---
# Put these on the API / Next.js server only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- AI (optional; without keys Relia uses grounded extraction from stored records) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2

# --- Email invitations (optional; invite URLs are returned when unset) ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=Relia <noreply@relia.app>

# --- Stripe (optional; demo-activate is used when these are empty) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_SUCCESS_URL=http://127.0.0.1:43180/settings/billing?checkout=success
STRIPE_CANCEL_URL=http://127.0.0.1:43180/settings/billing?checkout=cancel

# --- PostHog (optional) ---
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
