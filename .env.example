# Relia local / production environment
# Copy to .env and fill in only what you have. Do not commit .env.

# --- App ---
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:43180
CORS_ORIGINS=http://127.0.0.1:43180,http://localhost:43180
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
SEED_DEMO=true
# Production: APP_ENV=production, COOKIE_SECURE=true, SEED_DEMO=false
# Seed is refused when APP_ENV=production even if SEED_DEMO is accidentally true.

# SQLite by default. Production must use Postgres:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Next.js server-side proxy to FastAPI (not a browser variable)
API_INTERNAL_URL=http://127.0.0.1:43181

# --- Supabase ---
# Relia does not ship a browser Supabase client. Do NOT prefix these with NEXT_PUBLIC_.
# The browser talks only to Next.js, which proxies /api/v1/* to FastAPI.
#
# Required on the API for production Postgres:
#   DATABASE_URL          (see above)
#
# Optional on the API (server only) if you verify Supabase Auth JWTs later:
#   SUPABASE_URL          Project URL, e.g. https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY     Publishable/anon key (not needed in the Next.js bundle today)
#   SUPABASE_JWT_SECRET   JWT secret from Project Settings → API (server only)
#
# Not required by Relia today. If set, keep it on the API host only — never NEXT_PUBLIC_:
#   SUPABASE_SERVICE_ROLE_KEY
#
# FastAPI currently connects as the Postgres role in DATABASE_URL. That role
# bypasses RLS (table owner). Application queries still filter by org_id.
# RLS protects anon/authenticated PostgREST access. See docs/SUPABASE.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- AI (optional; without keys Relia uses grounded extraction from stored records) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2

# --- Email invitations (optional; invite URLs are returned when unset) ---
RESEND_API_KEY=
INVITE_FROM_EMAIL=Relia <noreply@relia.app>

# --- Stripe (optional; demo-activate is used when these are empty) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_SUCCESS_URL=http://127.0.0.1:43180/settings/billing?checkout=success
STRIPE_CANCEL_URL=http://127.0.0.1:43180/settings/billing?checkout=cancel

# --- PostHog (optional). These are the only NEXT_PUBLIC_ values Relia uses.
# They are analytics keys, not database or service-role credentials.
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
