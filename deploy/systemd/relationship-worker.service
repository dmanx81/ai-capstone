[Unit]
Description=Relationship Analysis Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/project
EnvironmentFile=-/etc/default/relationship-worker
Environment=PYTHONPATH=/path/to/project
ExecStart=/path/to/project/.venv/bin/python -m apps.api.worker --poll-interval 5
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
